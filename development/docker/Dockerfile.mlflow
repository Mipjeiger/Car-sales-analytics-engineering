FROM python:3.11-slim

WORKDIR /mlflow

# Install required system dependencies (added curl for healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install MLflow with PostgreSQL and AWS S3 remote support
RUN pip install --no-cache-dir \
    mlflow==2.11.3 \
    psycopg2-binary \
    boto3

EXPOSE 5000

# Run DB migration first, then start server workers
CMD ["sh", "-c", "mlflow db upgrade ${BACKEND_STORE_URI} && mlflow server --backend-store-uri ${BACKEND_STORE_URI:-sqlite:///mlflow/mlflow.db} --default-artifact-root ${ARTIFACT_ROOT:-/mlflow/artifacts} --host 0.0.0.0 --port 5000 --workers 2"]