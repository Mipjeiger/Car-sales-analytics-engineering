FROM python:3.11-slim

WORKDIR /mlflow

# Install required system dependencies for PostgreSQL & Git integration
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install MLflow with PostgreSQL and AWS S3 remote support
RUN pip install --no-cache-dir \
    mlflow==2.11.3 \
    psycopg2-binary \
    boto3

EXPOSE 5000

# Entry shell command array to dynamically read environment variables
CMD ["sh", "-c", "mlflow server --backend-store-uri ${BACKEND_STORE_URI:-sqlite:///mlflow/mlflow.db} --default-artifact-root ${ARTIFACT_ROOT:-/mlflow/artifacts} --host 0.0.0.0 --port 5000"]