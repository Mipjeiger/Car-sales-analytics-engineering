# ============================================
# 1. Git & Version Control
# ============================================
.git
.gitignore
.gitattributes

# ============================================
# 2. Python & Virtual Environments
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.tox/
.coverage
htmlcov/

# ============================================
# 3. Environment Variables & Secrets
# ============================================
.env
.env.*
*.pem
*.key
*.p12

# ============================================
# 4. Heavy Data & DVC Local Caches
# ============================================
# Exclude local DVC cache and temporary files (pulled inside container instead)
.dvc/cache
.dvc/tmp
# Local database mounts
pgdata/
# Large datasets/models if managed via DVC or S3
*.parquet
*.faiss

# ============================================
# 5. IDE, Editors, & OS Files
# ============================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================
# 6. Docker & Build Artifacts
# ============================================
Dockerfile*
docker-compose*.yml
.dockerignore
*.log