FROM python:3.11-slim

WORKDIR /app

# 1. Install curl for healthcheck & clean apt cache
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 2. Upgrade pip to handle modern wheel metadata efficiently
RUN pip install --no-cache-dir --upgrade pip

COPY docker/requirements-dagster.txt .

# 3. Add timeout, retry limits, and socket options to prevent PyPI read timeouts
RUN pip install \
    --no-cache-dir \
    --default-timeout=1000 \
    --retries=10 \
    -r requirements-dagster.txt

COPY . .

CMD ["dagster-webserver", "-f", "orchestration/repository.py", "-h", "0.0.0.0"]