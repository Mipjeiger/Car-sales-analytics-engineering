{
  "title": "MLOps Full Stack Dashboard",
  "uid": "car-sales-mlops",
  "version": 1,
  "panels": [
    {
      "title": "Container CPU",
      "type": "graph",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "targets": [{
        "expr": "rate(container_cpu_usage_seconds_total[5m]) * 100",
        "legendFormat": "{{ container }}"
      }]
    },
    {
      "title": "Container Memory",
      "type": "graph",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "targets": [{
        "expr": "container_memory_usage_bytes / 1024 / 1024",
        "legendFormat": "{{ container }} MB"
      }]
    },
    {
      "title": "Container Status",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "targets": [{
        "expr": "count(container_last_seen) by (container)"
      }]
    },
    {
      "title": "Network I/O",
      "type": "graph",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "targets": [
        {"expr": "rate(container_network_receive_bytes_total[5m])", "legendFormat": "RX"},
        {"expr": "rate(container_network_transmit_bytes_total[5m])", "legendFormat": "TX"}
      ]
    },

    {
      "title": "Request Rate",
      "type": "graph",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8},
      "targets": [{
        "expr": "rate(http_requests_total[5m])",
        "legendFormat": "{{ endpoint }}"
      }]
    },
    {
      "title": "Latency (95th)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 8},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, endpoint))",
        "legendFormat": "{{ endpoint }}"
      }]
    },
    {
      "title": "Error Rate",
      "type": "graph",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "targets": [{
        "expr": "rate(http_requests_total{status=~'5..'}[5m]) / rate(http_requests_total[5m])",
        "legendFormat": "Errors"
      }]
    },
    {
      "title": "Active Connections",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "targets": [{
        "expr": "sum(active_connections)"
      }]
    },

    {
      "title": "Prediction Volume",
      "type": "graph",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 16},
      "targets": [{
        "expr": "rate(predictions_total[1h])",
        "legendFormat": "Predictions/hour"
      }]
    },
    {
      "title": "Prediction Latency",
      "type": "graph",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 16},
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(prediction_duration_seconds_bucket[5m]))",
        "legendFormat": "P95 Latency"
      }]
    },
    {
      "title": "Model R² Score",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 16},
      "targets": [{
        "expr": "model_r2_score",
        "legendFormat": "{{ model_name }}"
      }],
      "fieldConfig": {
        "defaults": {"min": 0, "max": 1, "unit": "percentunit"}
      }
    },
    {
      "title": "Model Versions",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 16},
      "targets": [{
        "expr": "mlflow_model_versions_total",
        "legendFormat": "{{ model_name }}"
      }]
    },

    {
      "title": "Revenue Impact",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 24},
      "targets": [{
        "expr": "business_revenue_impact"
      }],
      "fieldConfig": {
        "defaults": {"unit": "currencyIDR", "decimals": 0}
      }
    },
    {
      "title": "Active Users",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 24},
      "targets": [{
        "expr": "business_active_users"
      }]
    },
    {
      "title": "Business KPIs",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [{
        "expr": "business_kpi_metrics",
        "format": "table"
      }]
    }
  ],
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  }
}